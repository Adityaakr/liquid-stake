# Vara RPC endpoints
VITE_VARA_TESTNET_RPC=wss://testnet.vara.network
VITE_VARA_MAINNET_RPC=wss://rpc.vara.network
# Set to "gear" to read real balances from the chain, "mock" for a fully simulated protocol
VITE_ADAPTER=mock
# Staking program (leave empty until deployed). When set, GearAdapter uses sails-js.
VITE_VAULTERA_PROGRAM_ID=
